#: cx_note/app_help.py:37
msgid "ID 或文本片段"
msgstr "ID or text fragment"

#: cx_note/app_help.py:40
msgid "目标条目（可传多个参数，每参数一条）：4 位 ID 全库精确匹配；或文本片段（当前域及下级域内匹配，须唯一命中）。"
msgstr ""
"Target entry (multiple arguments allowed, one per argument): a "
"4-character ID matches exactly across the whole store; or a text fragment"
" matched within the current domain and its subdomains, which must hit "
"exactly one entry."

#: cx_note/app_help.py:47
msgid "快速记录"
msgstr "Quick capture"

#: cx_note/app_help.py:49
msgid "记录一条内容到当前工作域；同域已有完全相同内容时不重复记录。"
msgstr ""
"Record an entry into the current working domain; identical content "
"already in the same domain is never duplicated."

#: cx_note/app_help.py:53
msgid "条目内容"
msgstr "Entry content"

#: cx_note/app_help.py:56
msgid "条目文本（可传多个参数，每参数一条）；字面 [u]\\n[/] 转换为换行，如 [u]add \"买菜\\n做饭\" \"交水电费\"[/]。"
msgstr ""
"Entry text (multiple arguments allowed, one per argument); a literal "
"[u]\\n[/] becomes a line break, e.g. [u]add \"buy groceries\\ncook\" "
"\"pay utility bill\"[/]."

#: cx_note/app_help.py:61
msgid "修改内容"
msgstr "Edit content"

#: cx_note/app_help.py:64
msgid "覆盖单条条目的内容；状态、所属域、ID、创建时间与 终态打点均不变，不做重复校验。"
msgstr ""
"Overwrite a single entry's content; status, domain, ID, creation time "
"and terminal-state timestamp stay unchanged; no duplicate check."

#: cx_note/app_help.py:70
msgid "目标条目"
msgstr "Target entry"

#: cx_note/app_help.py:72
msgid "要覆盖内容的条目：4 位 ID 或文本片段（唯一命中）。"
msgstr ""
"The entry to overwrite: a 4-character ID or a text fragment (must hit "
"exactly one entry)."

#: cx_note/app_help.py:76
msgid "新内容"
msgstr "New content"

#: cx_note/app_help.py:79
msgid "覆盖后的新内容；字面 [u]\\n[/] 转换为换行，如 [u]edit a1b2 \"改好的内容\"[/]。"
msgstr ""
"The new content to overwrite with; a literal [u]\\n[/] becomes a line "
"break, e.g. [u]edit a1b2 \"updated content\"[/]."

#: cx_note/app_help.py:85
msgid "查看列表"
msgstr "Browse the list"

#: cx_note/app_help.py:86
msgid "按域分组显示条目；不带动词运行时默认执行。"
msgstr "Show entries grouped by domain; the default when no verb is given."

#: cx_note/app_help.py:89
msgid "展开下级域的条目；默认下级域只显示标题行。"
msgstr "Expand subdomain entries; by default subdomains show header lines only."

#: cx_note/app_help.py:93
msgid "状态流转"
msgstr "Status transitions"

#: cx_note/app_help.py:94
msgid "把条目标记为已完成。"
msgstr "Mark an entry as done."

#: cx_note/app_help.py:96
msgid "把条目转入进行中。"
msgstr "Move an entry to in-progress."

#: cx_note/app_help.py:98
msgid "把条目重置为待办。"
msgstr "Reset an entry back to todo."

#: cx_note/app_help.py:100
msgid "把条目标记为已取消。"
msgstr "Mark an entry as cancelled."

#: cx_note/app_help.py:104
msgid "删除"
msgstr "Delete"

#: cx_note/app_help.py:105
msgid "删除单条条目。"
msgstr "Erase a single entry."

#: cx_note/app_help.py:109
msgid "清空当前工作域的直属条目（不含子域），交互确认一次。"
msgstr ""
"Empty the current working domain's direct entries (subdomains excluded), "
"with one interactive confirmation."

#: cx_note/app_help.py:114
msgid "终态清理：已完成与已取消条目超龄后在每次运行收尾时自动清理，保留天数由配置 [u]retention_days[/] 决定。"
msgstr ""
"Terminal-state cleanup: completed and cancelled entries are automatically"
" cleaned up at the end of each run once they exceed the retention period, "
"which is set by [u]retention_days[/] in the config."

#: cx_note/app_help.py:121
msgid "域选项"
msgstr "Domain options"

#: cx_note/app_help.py:125
msgid "域字面"
msgstr "Domain literal"

#: cx_note/app_help.py:128
msgid "指定工作域：以 [u]/[/] 开头为绝对域，否则相对当前域；对所有动词生效。"
msgstr ""
"Switch the working domain: a leading [u]/[/] means an absolute domain, "
"otherwise relative to the current one; applies to every verb."

#: cx_note/app_help.py:132
msgid "在根域操作。"
msgstr "Operate on the root domain."

#: cx_note/app_help.py:135
msgid "输出选项"
msgstr "Output options"

#: cx_note/app_help.py:137
msgid "向 stdout 输出纯净 JSON，跳过标题与一切装饰。"
msgstr "Write pure JSON to stdout, skipping the title and all decoration."

#: cx_note/app_help.py:140
msgid "展开下级域；同时扩大 [u]list --json[/] 的输出范围。"
msgstr "Expand subdomains; also widens the scope of [u]list --json[/] output."

#: cx_note/app_help.py:142
msgid "开启 debug 模式。"
msgstr "Enable debug mode."

#: cx_note/app_help.py:145
msgid "杂项"
msgstr "Misc"

#: cx_note/app_help.py:146
msgid "显示此分组帮助。"
msgstr "Show this grouped help."

#: cx_note/app_help.py:147
msgid "显示完整教程。"
msgstr "Show the full tutorial."

#: cx_note/app_help.py:152
msgid ""
"定位规则：[u]ID[/] 全库精确定位；[u]文本片段[/] 限可见域（当前域 + 下级域）且须唯一命中；[u]-p[/] "
"改变所有动词的工作域。终态 = 已完成（[u]finish[/]）与已取消（[u]drop[/]）。"
msgstr ""
"Target rules: an [u]ID[/] resolves exactly across the whole store; a "
"[u]text fragment[/] matches only within the visible domains (current + "
"subdomains) and must hit exactly one entry; [u]-p[/] changes the working "
"domain of every verb. Terminal states = done ([u]finish[/]) and cancelled"
" ([u]drop[/])."

#: cx_note/app_help.py:161
msgid ""
"cxnote —— 终端里的快速便签。\n"
"        以 [u]add[/] 记录、[u]list[/] 查看、[u]edit[/] 覆盖内容、[u]finish[/] "
"[u]pend[/] [u]reset[/] [u]drop[/] 流转状态、\n"
"        [u]erase[/] [u]clear[/] 删除。各条目级动词支持多个参数。运行 [u]cxnote "
"--tutorial[/] 学习完整用法。"
msgstr ""
"cxnote — a quick sticky note for your terminal.\n"
"        [u]add[/] to jot, [u]list[/] to browse, [u]edit[/] to overwrite "
"content, [u]finish[/] [u]pend[/] [u]reset[/] [u]drop[/] to move entries "
"through statuses,\n"
"        [u]erase[/] [u]clear[/] to delete. All entry-level verbs accept "
"multiple arguments. Run [u]cxnote --tutorial[/] for the full guide."

#: cx_note/app_help.py:182
msgid "CxNote 教程"
msgstr "CxNote Tutorial"

#: cx_note/appcontext.py:75
msgid "cxnote —— 终端里的快速便签。"
msgstr "cxnote — a quick sticky note for your terminal."

#: cx_note/appcontext.py:83
msgid "要执行的动作，缺省为 list"
msgstr "Action to perform (defaults to list)"

#: cx_note/appcontext.py:89
msgid ""
"动词参数（可传多个）：add 为多条条目内容，edit 为目标与新内容（恰好两个），finish/pend/reset/erase/drop "
"为多个 ID 或文本片段"
msgstr ""
"Verb arguments (multiple allowed): entry content for add; target and new "
"content for edit (exactly two); IDs or text fragments for "
"finish/pend/reset/erase/drop"

#: cx_note/appcontext.py:98
msgid "指定域字面（以 / 开头为绝对域，否则相对当前域）"
msgstr ""
"Domain literal (leading / = absolute, otherwise relative to the current "
"domain)"

#: cx_note/appcontext.py:105
msgid "在根域操作"
msgstr "Operate on the root domain"

#: cx_note/appcontext.py:111
msgid "向 stdout 输出纯净 JSON"
msgstr "Write pure JSON to stdout"

#: cx_note/appcontext.py:117
msgid "同时显示下级域的条目"
msgstr "Also show entries in subdomains"

#: cx_note/appcontext.py:124
msgid "开启 debug 模式"
msgstr "Enable debug mode"

#: cx_note/appcontext.py:132
msgid "显示分组帮助"
msgstr "Show grouped help"

#: cx_note/appcontext.py:139
msgid "显示完整教程"
msgstr "Show the full tutorial"

