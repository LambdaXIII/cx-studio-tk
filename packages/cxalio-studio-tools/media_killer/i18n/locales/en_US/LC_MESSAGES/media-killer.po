#: media_killer/app_help.py:33
msgid ""
"本工具从用户提供的输入中识别[u]预设文件[/]和[u]媒体源文件[/]，\n"
"                并基于它们生成一系列任务，调用 FFmpeg 进行转码。"
msgstr ""
"This tool identifies [u]preset files[/] and [u]media source files[/] from"
" input,\n"
"            and generates tasks to transcode via FFmpeg."

#: media_killer/app_help.py:38
msgid "输入"
msgstr "Input Files"

#: media_killer/app_help.py:38
msgid "预设文件与源文件的混合输入"
msgstr ""

#: media_killer/app_help.py:44
msgid "指定（多个）需要处理的文件，包括[u]预设文件[/]和[u]源文件路径[/]。"
msgstr ""
"Specify file(s) to process, including [u]preset files[/] and [u]source "
"file paths[/]."

#: media_killer/app_help.py:49
msgid "转码选项"
msgstr "Transcoding Options"

#: media_killer/app_help.py:49
msgid "控制转码操作的选项"
msgstr "Options for controlling transcoding operations"

#: media_killer/app_help.py:54
msgid "指定目标文件夹，覆盖预设中的目标目录。"
msgstr ""

#: media_killer/app_help.py:61
msgid ""
"设置任务的排序模式。\n"
"                    "
"四种模式分别为[u]按源文件路径[/]、[u]按预设[/]、[u]按目标文件路径[/]、[u]按输入顺序（默认）[/]。"
msgstr ""
"Set the task sorting mode. Tasks will be sorted before execution.\n"
"            The four modes are: [u]by source file path[/], [u]by "
"preset[/], [u]by target file path[/], [u]by input order[/]."

#: media_killer/app_help.py:71
msgid ""
"设置并行工作进程的数量，默认为 1。\n"
"                    不建议设置大于 2 的数值，除非你知道你在干什么。"
msgstr ""
"\n"
"                Set the number of parallel worker processes. Default is "
"1.\n"
"                Setting a value greater than 2 is not recommended unless "
"you know what you are doing.\n"
"                "

#: media_killer/app_help.py:77
msgid "启用[cx.error]强制覆盖模式[/]，忽略预设文件中的覆盖选项。"
msgstr ""
"When [cx.error]force overwrite mode[/] is enabled, overwrite options in "
"presets are ignored."

#: media_killer/app_help.py:82
msgid "启用[cx.success]安全模式[/]，无论如何也不覆盖已有目标文件。"
msgstr ""
"When [cx.success]safe mode[/] is enabled, all overwrite options are "
"ignored; target files will never be overwritten."

#: media_killer/app_help.py:86
msgid "其它操作"
msgstr "Other Operations"

#: media_killer/app_help.py:86
msgid "除转码之外的辅助操作"
msgstr "Run operations other than transcoding"

#: media_killer/app_help.py:92
msgid "以示例内容生成预设文件。[cx.warning]示例文件不可直接运行！[/]"
msgstr ""
"Generate a sample preset file. [cx.warning]Sample file cannot be run "
"directly![/]"

#: media_killer/app_help.py:98
msgid "将转码任务保存为脚本文件，不执行转码。"
msgstr ""
"Save transcoding tasks to a script file; will not perform actual "
"transcoding."

#: media_killer/app_help.py:104
msgid ""
"加载上次的[u]所有[/]转码任务并叠加到本次任务中。\n"
"建议附加 -n 选项以避免覆盖已完成的输出。"
msgstr ""
"Load [u]all[/] transcoding tasks from the last run and re-execute.\n"
"To continue running incomplete tasks, append the -n option."

#: media_killer/app_help.py:109
msgid "杂项"
msgstr "Misc"

#: media_killer/app_help.py:110
msgid "显示此帮助信息"
msgstr "Show this help message"

#: media_killer/app_help.py:114
msgid "显示完整的教程内容"
msgstr "Show full tutorial"

#: media_killer/app_help.py:116
msgid "开启调试模式以显示更多后台信息"
msgstr "Enable debug mode to see more background information"

#: media_killer/app_help.py:120
msgid "启用[cx.info]模拟运行模式[/]，不执行任何文件操作。"
msgstr "Enable [cx.info]pretending mode[/], no file operations will be performed."

#: media_killer/appcontext.py:228
msgid "-y（强制覆盖）与 -n（强制不覆盖）不可同时使用。"
msgstr ""

